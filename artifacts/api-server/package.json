{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run db:migrate && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "node --check server/index.js && node --check server/merge.js && node --check server/migrate.js",
    "db:migrate": "node server/migrate.js",
    "test:server": "node --test server/*.test.js"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  }
}
